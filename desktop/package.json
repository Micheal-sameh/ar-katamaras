{
  "name": "avarewase-readings-desktop",
  "productName": "Avarewase Readings",
  "version": "1.0.0",
  "description": "Desktop app for the Avarewase daily readings",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "node scripts/sync.js && electron .",
    "dist": "node scripts/sync.js && electron-builder",
    "dist:win": "node scripts/sync.js && electron-builder --win",
    "dist:mac": "node scripts/sync.js && electron-builder --mac",
    "dist:linux": "node scripts/sync.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.avarewase.readings",
    "productName": "Avarewase Readings",
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "ar",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Avarewase-Readings-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Avarewase-Readings-Portable-${version}.exe"
    }
  },
  "author": "Avarewase"
}