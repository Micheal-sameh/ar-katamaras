# Copy to docker/app.env and fill in. docker/app.env is git-ignored.
# Settings fixed by docker-compose.yml (database path, Redis, production mode) are not repeated here.

# docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://readings.example.org
APP_TIMEZONE=Africa/Cairo

# Leave empty: nginx (inside the stack) already works out the visitor IP from X-Forwarded-For.
TRUSTED_PROXIES=

# Restrict who may call the API from other websites (comma separated). Default "*" = anyone.
# CORS_ALLOWED_ORIGINS=https://readings.example.org

KATAMEROS_API_URL=https://api.katameros.app
READINGS_WARM_DAYS=7
READINGS_ALERT_BELOW_DAYS=3
READINGS_THROTTLE_PER_MINUTE=30
READINGS_PAST_DAYS=366
READINGS_FUTURE_DAYS=366

# Failure email for the monthly pre-cache (sent to READINGS_ALERT_EMAIL). Without a real SMTP server
# the email is only written to the log, so fill these in:
READINGS_ALERT_EMAIL=micheal.sameh@avarewase.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=readings@avarewase.com
MAIL_FROM_NAME="Avarewase Readings"
